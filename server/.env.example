# 腾讯云 API 密钥
# 获取地址：https://console.cloud.tencent.com/cam/capi
# 强烈建议使用「子账号 + 仅授予 QcloudWSAFullAccess 策略」的密钥，不要用主账号密钥
TENCENTCLOUD_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TENCENTCLOUD_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 本地服务端口
PORT=4174

# 企业主体信息数据源（二选一，都不填则「查主体」功能提示未配置）
# 企查查开放平台：https://openapi.qcc.com/
QCC_KEY=
QCC_SECRET_KEY=

# 天眼查开放平台：https://open.tianyancha.com/
TYC_TOKEN=
